# JobScope Environment Configuration
PROJECT_NAME="JobScope — Job Market Intelligence & Salary Predictor"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# Database Configuration (SQLite default; PostgreSQL compatible)
DATABASE_URL="sqlite:///./jobscope.db"

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Data & Models paths
RAW_DATA_PATH="data/raw/sample_jobs_raw.csv"
PROCESSED_DATA_PATH="data/processed/jobscope_cleaned.csv"
MODEL_DIR="data/models"
METRICS_PATH="data/models/model_metadata.json"
DATA_REPORT_PATH="data/processed/data_quality_report.json"
DATASET_METADATA_PATH="data/processed/dataset_metadata.json"
